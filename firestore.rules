rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Profile Document
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isOwner(userId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['userId', 'email', 'role', 'theme'])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 200;

      allow update: if isOwner(userId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.email == resource.data.email;

      allow delete: if isOwner(userId);

      // Tasks Subcollection
      match /tasks/{taskId} {
        allow get: if isOwner(userId) && isValidId(taskId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId)
          && isValidId(taskId)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 300
          && request.resource.data.estimatedMinutes is number;

        allow update: if isOwner(userId)
          && isValidId(taskId)
          && request.resource.data.userId == request.auth.uid;

        allow delete: if isOwner(userId) && isValidId(taskId);
      }

      // Sessions Subcollection
      match /sessions/{sessionId} {
        allow get: if isOwner(userId) && isValidId(sessionId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId)
          && isValidId(sessionId)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 300;

        allow update: if isOwner(userId)
          && isValidId(sessionId)
          && request.resource.data.userId == request.auth.uid;

        allow delete: if isOwner(userId) && isValidId(sessionId);
      }
    }
  }
}
